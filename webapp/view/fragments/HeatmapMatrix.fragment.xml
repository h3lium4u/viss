<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:dash="sap.dashboard.control">
    <VBox width="100%">
        <!-- Heatmap Legend -->
        <HBox wrap="Wrap" alignItems="Center" class="sapDashHeatmapLegend">
            <Label text="Assignment Intensity Scale:" class="sapUiTinyMarginEnd" />

            <HBox alignItems="Center" class="sapUiTinyMarginEnd">
                <core:HTML content="&lt;span class='sapDashHeatmapLegendBox' style='background: repeating-linear-gradient(45deg, #f5f6f7, #f5f6f7 4px, #e2e8f0 4px, #e2e8f0 8px); border: 1px dashed #a8b4be;'&gt;&lt;/span&gt;" />
                <Text text="No Data (—)" />
            </HBox>

            <HBox alignItems="Center" class="sapUiTinyMarginEnd">
                <core:HTML content="&lt;span class='sapDashHeatmapLegendBox' style='background-color: #fff9ed; border: 1px solid #ffd591;'&gt;&lt;/span&gt;" />
                <Text text="0%" />
            </HBox>

            <HBox alignItems="Center" class="sapUiTinyMarginEnd">
                <core:HTML content="&lt;span class='sapDashHeatmapLegendBox' style='background-color: #e6f4ff; border: 1px solid #bae0ff;'&gt;&lt;/span&gt;" />
                <Text text="1–25%" />
            </HBox>

            <HBox alignItems="Center" class="sapUiTinyMarginEnd">
                <core:HTML content="&lt;span class='sapDashHeatmapLegendBox' style='background-color: #91caff; border: 1px solid #69b1ff;'&gt;&lt;/span&gt;" />
                <Text text="26–50%" />
            </HBox>

            <HBox alignItems="Center" class="sapUiTinyMarginEnd">
                <core:HTML content="&lt;span class='sapDashHeatmapLegendBox' style='background-color: #4096ff; border: 1px solid #1677ff;'&gt;&lt;/span&gt;" />
                <Text text="51–75%" />
            </HBox>

            <HBox alignItems="Center" class="sapUiTinyMarginEnd">
                <core:HTML content="&lt;span class='sapDashHeatmapLegendBox' style='background-color: #1677ff; border: 1px solid #0958d9;'&gt;&lt;/span&gt;" />
                <Text text="76–99%" />
            </HBox>

            <HBox alignItems="Center">
                <core:HTML content="&lt;span class='sapDashHeatmapLegendBox' style='background-color: #0a6ed1; border: 1px solid #0854a0;'&gt;&lt;/span&gt;" />
                <Text text="100% Fully Assigned" />
            </HBox>
        </HBox>

        <!-- Heatmap Cell Grid -->
        <HBox wrap="Wrap" items="{dashboard>/filteredItems}" class="sapDashHeatmapGrid">
            <dash:HeatmapCell
                itemId="{dashboard>id}"
                name="{dashboard>name}"
                assigned="{dashboard>assigned}"
                notAssigned="{dashboard>notAssigned}"
                total="{dashboard>total}"
                assignedPercentage="{dashboard>assignedPercentage}"
                status="{dashboard>status}"
                press=".onItemPress" />
        </HBox>
    </VBox>
</core:FragmentDefinition>
